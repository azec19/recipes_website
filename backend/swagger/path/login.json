{
    "post": {
        "summary": "Log in as a user",
        "tags": [
            "Login"
        ],
        "requestBody": {
            "required": true,
            "content": {
                "application/json": {
                    "schema": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "password": {
                                    "type": "string"
                                }
                            }
                        }
                }
            }
        },
        "responses": {
            "200": {
                "description": "Result of log in process",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "token": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}