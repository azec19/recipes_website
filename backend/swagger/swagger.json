  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "UserwithouID": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Ingredient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "Type": {
            "type": "string"
          },
          "Quantity": {
            "type": "number",
            "format": "float"
          },
          "Unit": {
            "type": "string"
          }
        }
      },
      "Mood": {
        "type": "string",
        "enum": [
          "CHILL",
          "PARTY",
          "BEFORE",
          "MAIN_DISHES",
          "DESERT"
        ]
      },
      "Difficulties": {
        "type": "string",
        "enum": [
          "EASY",
          "MEDIUM",
          "TECHNICAL",
          "HARD",
          "IMPOSSIBLE"
        ]
      },
      "Recipe": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "Date": {
            "type": "string"
          },
          "Autor": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Instructions": {
            "type": "string"
          },
          "Ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            }
          },
          "Mood": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mood"
            }
          },
          "Preparation_time": {
            "type": "integer"
          },
          "Cooking_time": {
            "type": "integer"
          },
          "Quantity": {
            "type": "string"
          },
          "Difficultie": {
            "$ref": "#/components/schemas/Difficulties"
          },
          "Photo": {
            "type": "string"
          },
          "Tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Calorie": {
            "type": "string"
          }
        }
      }
    }
