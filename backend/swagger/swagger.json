  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "UserwithouID": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Ingredient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "StockIngredient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "ingredientID": {
            "type": "integer"
          },
          "quantity": {
            "type": "number",
            "format": "float"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "RecipeIngredient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "ingredientID": {
            "type": "integer"
          },
          "quantity": {
            "type": "number",
            "format": "float"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "Mood": {
        "type": "string",
        "enum": [
          "CHILL",
          "PARTY",
          "BEFORE",
          "MAIN_DISHES",
          "DESERT"
        ]
      },
      "Difficulties": {
        "type": "string",
        "enum": [
          "EASY",
          "MEDIUM",
          "TECHNICAL",
          "HARD",
          "IMPOSSIBLE"
        ]
      },
      "Recipe": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "autor": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            }
          },
          "mood": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mood"
            }
          },
          "preparation_time": {
            "type": "integer"
          },
          "cooking_time": {
            "type": "integer"
          },
          "quantity": {
            "type": "string"
          },
          "difficultie": {
            "$ref": "#/components/schemas/Difficulties"
          },
          "photo": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "calorie": {
            "type": "string"
          }
        }
      }
    }
  }
