{
  "openapi": "3.0.0",
  "info": {
    "title": "User API",
    "description": "API for managing users",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
    "tags": [
    {
      "name": "Login",
      "description": "Opérations liées à l'authentification"
    },
    {
      "name": "Users",
