// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Mood {
  CHILL
  PARTY
  BEFORE
  MAIN_DISHES
  DESERT
}

enum Types {
  FECULENT
  LEGUME
  CHAMPIGNON
  FRUIT
  LAITIER
  VIANDE
  POISSON
  MATIERE_GRASSE
  EPICE
  LIQUIDE
  AUTRE
}

enum Units {
  KG
  GR
  L
  CL
  DL
  UNITE
  CAS
  CAF
}

enum Difficulties {
  EASY
  MEDIUM
  TECHNICAL
  HARD
  IMPOSSIBLE
}

model User {
  id    Int    @id @default(autoincrement())
  name  String @unique
  password String
}

model Ingredient {
  id   Int    @id @default(autoincrement())
  name String @unique
  type Types

  stock            StockIngredient?
  recipeIngredient RecipeIngredient[]
}

model StockIngredient {
  id           Int @id @default(autoincrement())
  ingredientId Int @unique

  user     String
  quantity Float
  unit     Units


  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model RecipeIngredient {
  recipeId     Int
  ingredientId Int

  quantity Float
  unit     Units

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([recipeId, ingredientId])
}

model Recipe {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  date             DateTime           @default(now())
  autor            String
  description      String
  instructions     String[]
  ingredients      RecipeIngredient[]
  mood             Mood[]
  preparation_time Int
  cooking_time     Int
  quantity         String
  difficultie      Difficulties
  photo            String
  tools            String[]
  calorie          String
}
