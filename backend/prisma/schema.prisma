// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Mood {
  CHILL
  PARTY
  BEFORE
  MAIN_DISHES
  DESERT
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
}

model Ingredient {
  id       Int     @id @default(autoincrement())
  Name     String  @unique
  Type     String
  Quantity Float
  Unit     String
  recipe   Recipe[]
}

model Recipe {
  id               Int          @id @default(autoincrement())
  Name             String       @unique
  Date             DateTime     @default(now())
  Autor            String
  Description      String
  Instructions     String
  Ingredients      Ingredient[]
  mood             Mood[]
  Preparation_time Int
  Cooking_time     Int
  Quantity         String
  Photo            String
  Tools            String[]
  Calorie          String
}
